<Project>
  <PropertyGroup>
    <!-- The release version is shared by the CLI and Core; CI may override it explicitly. -->
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">1.5.0</ReleaseVersion>
    <!-- CI supplies github.run_number. Local builds are deterministic and use zero. -->
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
  </PropertyGroup>
</Project>
