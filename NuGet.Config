<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Configure the authenticated sphere10-gitea-private source outside this repository. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="sphere10-gitea-private">
      <package pattern="Sphere10.Framework*" />
      <package pattern="Sphere10.HashLib4CSharp" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
